# Factorial, recursive and iterative

fn fact(n int) int:
    if n <= 1:
        return 1
    return n * fact(n - 1)

fn fact_loop(n int) int:
    let result := 1
    for i in 2..n + 1:
        result *= i
    return result

fn main(args):
    for n in [0, 5, 10, 20]:
        print(f"{n}! = {fact(n)} = {fact_loop(n)}")
