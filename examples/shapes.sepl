enum shape:
    circle(r)
    rect(w int, h int)
    empty

impl shape:
    fn area(self):
        return match self:
            shape::circle(r): 3 * r * r
            shape::rect(w, h): w * h
            shape::empty: 0

let shapes = [shape::circle(2), shape::rect(w: 3, h: 4), shape::empty]
for s in shapes:
    print(s, s.area())

fn parse_age(text):
    let n = int(text.trim())
    if n < 0:
        return result::err(f"age cannot be negative: {n}")
    return result::ok(n)

fn older(text):
    let age = parse_age(text)?
    return result::ok(age + 1)

fn main():
    print(older("41"), older("-3"))
    print(older("7").unwrap(), older("-1").unwrap_or(0), older("5").is_ok())
